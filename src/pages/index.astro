---
import '../styles/style.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Relli's Stuff</title>
    <link
      rel="icon"
      href="/relli_logo_100x100.png"
      type="image/x-icon"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Aldrich&display=swap" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/8e4463ebba.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <header>
        <h1>THIS PAGE IS UNDER CONSTRUCTION</h1>
        <div class="profile-image">
          <img src="/relli_peek_solidbackground.png" />
        </div>
        <h1>Relli</h1>
        <p class="location">
          <i class="fa-solid fa-location-dot"></i> Kentucky, USA
        </p>
        <p class="description">Unity Developer | 3D Artist | VR Enthusiast | Rainbow Bird</p>
        
        <div class="social-links">
          <a href="https://github.com/RadiatedPi" title="GitHub" target="_blank">
            <i class="fab fa-github"></i>
          </a>
          <a href="https://discord.com/users/371984160132169731" title="Discord" target="_blank">
            <i class="fab fa-discord"></i>
          </a>
          <a href="https://x.com/devsebastian44" title="Bluesky" target="_blank">
            <i class="fa-brands fa-bluesky"></i>
          </a>
        </div>
      </header>
      
      
      <!-- Main Cards -->
      <main>
        <a
          href="https://devsebastian44.vercel.app/"
          target="_blank"
          style="text-decoration: none; color: inherit;"
        >
          <div class="card">
            <div class="icon">
              <img src="/Portafolio.png" alt="Portafolio" />
            </div>
            <div class="card-content">
              <h2>Portafolio</h2>
              <p>Mis proyectos en desarrollo, ciberseguridad y datos</p>
            </div>
          </div>
        </a>

        <a
          href="https://github.com/devsebastian44/Conocimiento"
          target="_blank"
          style="text-decoration: none; color: inherit;"
        >
          <div class="card">
            <div class="icon">
              <img
                src="https://img.icons8.com/?size=100&id=33281&format=png&color=FFFFFF"
                alt="CodeMatrix"
              />
            </div>
            <div class="card-content">
              <h2>Conocimiento</h2>
              <p>Repositorio con todos mis apuntes sobre diferentes temas de tecnología</p>
            </div>
          </div>
        </a>

        <a
          href="https://github.com/Devsebastian44/Pentest-Docs"
          target="_blank"
          style="text-decoration: none; color: inherit;"
        >
          <div class="card">
            <div class="icon">
              <img
                src="https://img.icons8.com/?size=100&id=2957&format=png&color=FFFFFF"
                alt="Pentest-Docs"
              />
            </div>
            <div class="card-content">
              <h2>Pentest Docs</h2>
              <p>Repositorio con documentación detallada de máquinas CTF resueltas paso a paso</p>
            </div>
          </div>
        </a>
      </main>

      <div id="vrchat-embed">
          <div id="vrchat-card">
            <div id="vrchat-image">
              <object
                type="image/svg+xml"
                data="https://vrc.dissonant.dev/usr_27e51b3d-7588-4247-840b-5f1f56c20bb1/small.svg?foreground_color=FFFFFF"
                width="250"
                height="150"
                title="My VRChat status"
                style="color-scheme: light;"
              >
              </object>
            </div>
            <div id="vrchat-link">
              <a href="https://vrchat.com/home/user/usr_27e51b3d-7588-4247-840b-5f1f56c20bb1" target="_blank">
                <img src="transparent.png" width="250" height="150" />
              </a>
            </div>
          </div>
      </div>

      <!-- YouTube Section -->
      <section class="youtube-section">
        <h2><i class="fas fa-video"></i> Último video de YouTube</h2>
        <div class="video-container">
          <div class="video-embed">
            <iframe
              width="100%"
              height="315"
              src="https://www.youtube.com/embed/YVWX1bDaucs"
              title="Sistemas Operativos para Hacking Ético"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              style="border-radius: 8px;"
            >
            </iframe>
          </div>
        </div>

        <script>
          function copyLink() {
            const videoUrl = 'https://www.youtube.com/watch?v=YVWX1bDaucs';
            navigator.clipboard.writeText(videoUrl).then(() => {
              alert('¡Vínculo copiado al portapapeles!');
            });
          }
        </script>
      </section>
    </div>
  </body>
</html>
